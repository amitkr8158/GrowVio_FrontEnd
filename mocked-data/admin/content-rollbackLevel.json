{
  "service": "contentService",
  "function": "rollbackLevel",
  "method": "POST",
  "endpoint": "/api/admin/books/:bookId/levels/:level/rollback",
  "description": "Roll back a level to a previous published version.",
  "request": {
    "bookId": "bk_1001",
    "level": 4,
    "toVersion": 5
  },
  "response": {
    "success": true,
    "level": 4,
    "currentVersion": 5,
    "rolledBackAt": "2026-08-11T09:24:00Z"
  }
}
